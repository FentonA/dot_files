### Status Bar
bar {
    swaybar_command waybar
}

### Startup — infrastructure only
#
# The apps themselves are NOT launched here. Each session profile decides what
# to open: config (the plain "Sway" session) starts the usual everything-at-once
# set, while profiles/careerplug.config starts one app per workspace. Anything
# added below runs in *every* session, so keep it to daemons.
include /etc/sway/config.d/*

exec gnome-keyring-daemon --start --components=secrets
exec_always dunst
exec bluetoothctl
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec /usr/libexec/xdg-desktop-portal-wlr
exec wl-clip-persist --clipboard regular
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

### Display configuration
# Zen Browser PiP - float, sticky, small size
for_window [app_id="zen" title="Picture-in-Picture"] {
    floating enable
    sticky enable
    border none
    resize set 400 225
    move position 1500 800
}


# Fallback for other PiP titles
for_window [title="Picture-in-Picture"] floating enable, sticky enable, border none
for_window [title="Picture in picture"] floating enable, sticky enable, border none

### Window rules
for_window [app_id="thunderbird"] move scratchpad
# TickTick runs under XWayland, so it has a `class` and no `app_id` at all —
# the old [app_id="Ticktick"] rule could never match and TickTick would sit on
# whatever workspace happened to be focused when it started. Matching on class
# is what actually sends it to the scratchpad. (Discord is XWayland too, but it
# has no rule here by design; it is simply not autostarted in Sway(fonn).)
for_window [class="ticktick"] move scratchpad
for_window [app_id="Ticktick"] move scratchpad
