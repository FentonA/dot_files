#!/usr/bin/env bash
# sway-layout — open the apps a layout names, on the workspaces it names.
#
#   sway-layout fonn          # apply ~/.config/sway-layouts/fonn.layout
#   sway-layout fonn --dry-run
#
# Run from config/sway/profiles/fonn.config as:  exec $HOME/.local/bin/sway-layout fonn
#
# The whole trick is that sway opens a new window on whatever workspace is
# focused. So rather than launching everything and then trying to work out which
# window belongs where, this switches to the workspace first, launches one app,
# and waits for a window to show up before moving to the next.
#
# A workspace number may appear more than once in a layout — that is how a
# screen ends up split between two apps. They open left to right in the order
# the file lists them.
#
# That matters because identifying windows is genuinely unreliable here: Slack
# and Obsidian are XWayland (class, no app_id), Obsidian is a flatpak, and
# ghostty silently refuses to start at all if --class isn't a valid reverse-DNS
# GTK application id. Waiting on "did the count go up" sidesteps all of it.
#
# The cost is that startup is serial — roughly the sum of the apps' start times,
# not the slowest one. At login that is the right trade: correct beats quick.

set -uo pipefail

# sway inherits its PATH from the login manager, which does NOT include
# ~/.local/bin — that is added by the shell profile, and nothing here is a login
# shell. Anything installed there (zen, for one) would simply not be found.
# Prepending rather than appending so a hand-installed build wins over a distro
# package of the same name, which is the reason it is in ~/.local/bin.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

LAYOUT_DIR="${SWAY_LAYOUT_DIR:-$HOME/.config/sway-layouts}"
TIMEOUT="${SWAY_LAYOUT_TIMEOUT:-30}"     # per app, seconds
LOG="${XDG_RUNTIME_DIR:-/tmp}/sway-layout.log"

# Log to a file as well as stderr. At login there is no terminal attached, and
# notify-send is worse than useless there — with no notification daemon up yet
# it blocks on a dbus activation timeout for minutes.
log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG" >&2; }
die() { log "error: $*"; exit 1; }

command -v swaymsg >/dev/null || die "swaymsg not found — not a sway session?"
command -v jq      >/dev/null || die "jq is required"

# Number of real windows on a workspace. Views are the tree nodes that own a
# pid; workspaces and split containers don't.
ws_count() {
  swaymsg -t get_tree | jq --arg ws "$1" '
    [ recurse(.nodes[]?, .floating_nodes[]?)
      | select(.type == "workspace" and .name == $ws)
      | recurse(.nodes[]?, .floating_nodes[]?)
      | select(.pid != null) ] | length' 2>/dev/null || echo 0
}

NAME="${1:-}"; [ -n "$NAME" ] || die "usage: sway-layout <name> [--dry-run]"
DRY=0; [ "${2:-}" = "--dry-run" ] && DRY=1

FILE="$LAYOUT_DIR/$NAME.layout"
[ -r "$FILE" ] || die "no layout at $FILE"

: > "$LOG"
log "applying layout '$NAME'"

# Read the whole file up front. The loop below launches apps and sleeps, and
# reading line-by-line from the file over that would keep the fd open for the
# entire startup for no reason.
mapfile -t LINES < <(grep -vE '^[[:space:]]*(#|$)' "$FILE")
[ "${#LINES[@]}" -gt 0 ] || die "$FILE has no screens defined"

# How many apps each workspace is getting. Counted before anything launches,
# because a screen that will hold two apps has to be split before the first one
# opens, and because the "already there" check below works per slot, not per
# workspace.
declare -A planned=()
for line in "${LINES[@]}"; do
  ws="${line%%[[:space:]]*}"
  [[ $ws =~ ^[0-9]+$ ]] && planned[$ws]=$(( ${planned[$ws]:-0} + 1 ))
done

first_ws=""
declare -A placed=()
deferred=()
for line in "${LINES[@]}"; do
  ws="${line%%[[:space:]]*}"                       # first token
  cmd="${line#"$ws"}"                              # the rest
  cmd="${cmd#"${cmd%%[![:space:]]*}"}"             # ltrim

  # `-` means "no screen of its own" — a scratchpad app. Held back until every
  # numbered screen is placed, because such a window maps briefly on the focused
  # workspace before its for_window rule moves it away, and that flicker would
  # otherwise be counted as the screen's own app showing up.
  if [ "$ws" = "-" ]; then
    [ -n "$cmd" ] && deferred+=("$cmd")
    continue
  fi

  if ! [[ $ws =~ ^[0-9]+$ ]]; then
    log "skip: '$line' does not start with a workspace number or -"
    continue
  fi
  [ -n "$cmd" ] || { log "skip: workspace $ws has no command"; continue; }
  [ -z "$first_ws" ] && first_ws=$ws

  if ((DRY)); then
    log "would open on workspace $ws: $cmd"
    continue
  fi

  # Check the binary exists before launching. Without this a typo or a missing
  # app is indistinguishable from a slow one: the launch fails instantly, and
  # the script then waits out the full timeout for a window that is never
  # coming. That is exactly how a missing zen cost 30 seconds and looked like a
  # hang rather than a "not installed".
  # Idempotent per slot rather than per workspace: the Nth app on a screen is
  # skipped once that screen already holds N windows. Re-running mid-session
  # still opens nothing twice, but a screen shared by two apps no longer stops
  # after the first of them.
  #
  # It counts windows, so it cannot tell WHICH app is missing: if the first app
  # on a shared screen never starts and you re-run this mid-session, the second
  # one is launched again. Harmless for everything here — a second `flatpak run`
  # raises the running instance — but it does steal focus. A skipped app still
  # consumes its slot so the ones after it keep their position.
  slot=${placed[$ws]:-0}
  exe="${cmd%%[[:space:]]*}"
  if ! command -v "$exe" >/dev/null 2>&1; then
    log "workspace $ws: '$exe' not found on PATH — skipping (PATH=$PATH)"
    placed[$ws]=$((slot + 1))
    continue
  fi

  before=$(ws_count "$ws")
  if [ "$before" -gt "$slot" ]; then
    log "workspace $ws already has $before window(s) — leaving slot $((slot + 1)) alone"
    placed[$ws]=$((slot + 1))
    continue
  fi

  log "workspace $ws: $cmd"
  swaymsg workspace number "$ws" >/dev/null

  # Side by side, not one above the other. sway's default_orientation is `auto`,
  # which takes the split direction from the output's aspect ratio, so on a
  # portrait screen two apps would stack. Only worth saying where a second app
  # is actually coming.
  if [ "$slot" -eq 0 ] && [ "${planned[$ws]:-1}" -gt 1 ]; then
    swaymsg splith >/dev/null
  fi

  # setsid so the app is not in this script's process group: sway reaps the
  # exec'd command's group when the script exits, which would take the apps
  # down with it.
  setsid sh -c "$cmd" >/dev/null 2>&1 &

  deadline=$((SECONDS + TIMEOUT))
  while ((SECONDS < deadline)); do
    [ "$(ws_count "$ws")" -gt "$before" ] && break
    sleep 0.25
  done

  if [ "$(ws_count "$ws")" -gt "$before" ]; then
    log "workspace $ws: window up"
  else
    log "workspace $ws: nothing appeared within ${TIMEOUT}s — moving on"
  fi
  placed[$ws]=$((slot + 1))
done

# Land on the first screen before starting the scratchpad apps, so that if one
# of them ignores its rule it lands somewhere predictable rather than on
# whichever screen happened to be focused last.
[ -n "$first_ws" ] && ((DRY == 0)) && swaymsg workspace number "$first_ws" >/dev/null

for cmd in ${deferred[@]+"${deferred[@]}"}; do
  if ((DRY)); then log "would start (no screen): $cmd"; continue; fi
  exe="${cmd%%[[:space:]]*}"
  if ! command -v "$exe" >/dev/null 2>&1; then
    log "no screen: '$exe' not found on PATH — skipping"
    continue
  fi
  # The numbered screens are kept idempotent by the "workspace already has a
  # window" check, but these have no workspace to test. Without a guard of their
  # own, re-running mid-session opens a second Thunderbird window every time.
  # Match on process name first (covers `thunderbird`, `ticktick`), then on the
  # full command line (covers wrappers like `flatpak run ...`, where the process
  # is never named after the first word).
  if pgrep -x "$(basename "$exe")" >/dev/null 2>&1 || pgrep -f -- "$cmd" >/dev/null 2>&1; then
    log "no screen: $exe already running — leaving it alone"
    continue
  fi
  log "no screen: $cmd"
  setsid sh -c "$cmd" >/dev/null 2>&1 &
done

((DRY)) && exit 0
log "done — landed on workspace ${first_ws:-1}"
